  "config": {
    "purpose": "frozen P4 evaluation, run once at the frozen sample size",
    "partition": "P4 only; P0 reserved and never read",
    "p4_history": "P4 was used in the Check-in 1 analyses (probe fitting and reporting), so it is NOT a previously untouched final test set. It was excluded from the current candidate discovery (P1+P2) and from the intervention tuning pilot (P3). P0 remains reserved from fitting, selection, tuning and scoring.",
    "n_per_class": 200,
    "selection_rule": "within each class, sort eligible P4 proteins by frozen sequence SHA-256 hex ascending and take the first 200. No random seed. No filtering by candidate activation, signal annotation or model outcome.",
    "eligibility": "role == evaluation and in_core == 1 in the prepared inclusion manifest (engineering proteins and p0_base_collision records already excluded); original length 60-1022; standard 20 amino acids only",
    "positions": [
      10,
      20,
      30
    ],
    "multipliers": [
      0.0,
      1.0,
      2.0
    ],
    "candidates_controlled": [
      2564,
      3900
    ],
    "candidate_descriptive": 1446,
    "edit": "validated direct decoder-delta at the masked position only",
    "control_norm_matching": {
      "construction": "delta_a_control = sign * T / (||w_dec[control]||_2 * std[p]), T = candidate's realised ||delta_h|| on the same masked input and token",
      "relative_tolerance": 1e-05,
      "justification": "Derived from fp32 precision and the validated edit implementation, not from any observed effect. The intervention validation measured the direct decoder-delta against a float64 reference at median relative L2 error 3.367e-07 and maximum 9.829e-07, with a minimum of 6.01 significant digits against fp32's ~7.2. 1e-5 is about an order of magnitude above that worst case: it admits fp32 rounding and rejects construction error.",
      "prohibited": "no clipping, no latent insertion, no silent control replacement, no widening of the matching rule"
    },
    "primary_outcome": {
      "name": "paired KL difference",
      "definition": "for each usable protein/position/condition: average the AVAILABLE control KLs, subtract from the candidate KL, then average those paired position differences within protein; summarise across proteins",
      "kl": "KL(clean || edited), AA-20 renormalised, in nats",
      "note": "a neutral name. This is not a measure of localisation specificity."
    },
    "primary_contrasts": "4 = 2 candidates x 2 non-zero edit conditions (multipliers 0 and 2)",
    "uncertainty": {
      "method": "protein-level resampling stratified by localisation class",
      "n_resamples": 10000,
      "seed": 20261122,
      "intervals": "ordinary 95% BCa, plus Bonferroni-adjusted 98.75% BCa for the 4 primary contrasts",
      "degenerate_fallback": "FIXED BEFORE RUNNING: if the BCa bias-correction z0 is non-finite (every resample on one side of the observed statistic) or the acceleration denominator is zero, fall back to the ordinary percentile interval at the same level and record interval_method = 'percentile_fallback' with the reason. A failed interval is never dropped and never left blank.",
      "units": "proteins. Positions and control features are NOT independent sample units."
    },
    "availability_policy": "an inactive candidate yields a genuine no-edit candidate outcome; an unavailable matched-control comparison is MISSING and is never imputed as zero",
    "design_note": "the 200/200 design is deliberately balanced and does not represent natural cohort prevalence. Class-specific results are reported alongside the pooled sampled-population result. No post-result weighting is applied."
  },
