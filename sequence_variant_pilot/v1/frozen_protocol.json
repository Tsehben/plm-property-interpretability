        "direction_sign": -1
      }
    },
    "edit": "validated direct decoder-delta at the currently masked token only, hook on esm.encoder.layer[7]",
    "sampling": {
      "distribution": "AA-20 renormalised softmax at the masked token of the arm's own current forward pass",
      "temperature": 1.0,
      "filters": "none: no top-k, no top-p, no repetition penalty, no banned tokens",
      "amino_acid_ordering": [
        "A",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "K",
        "L",
        "M",
        "N",
        "P",
        "Q",
        "R",
        "S",
        "T",
        "V",
        "W",
        "Y"
      ],
      "method": "inverse CDF over AA_ORDER using the shared uniform",
      "original_allowed": "yes; sampling the original amino acid is permitted and is not resampled. Ten mutations are NOT forced.",
      "carry_forward": "each sampled substitution is written into that arm's sequence and carried into its next step"
    },
    "common_random_numbers": {
      "scheme": "u = int(SHA-256('<sample_sha256>|crn|<ACC>|<replicate>|<step>')[:8]) / 2**64",
      "arm_independent": true,
      "caveat": "identical uniforms across arms. After the trajectories diverge this is a coupling of the randomness only -- the conditional distributions being inverted are no longer identical, so this is variance reduction, not exact pairing."
    },
    "random_directions": {
      "distribution": "isotropic on the unit sphere S^1279: g ~ N(0, I_1280), u = g/||g||_2",
      "generator": "numpy PCG64 (np.random.default_rng) seeded per (protein, replicate)",
      "seed": "int(SHA-256('<sample_sha256>|dir|<ACC>|<replicate>')[:8])",
      "n_directions": "one per (protein, replicate) = 4 per protein, held fixed across that trajectory's ten steps",
      "signs": "arm D injects +u, arm E injects -u",
      "norm_rule": "on each control arm's OWN current masked input, inject the norm that the corresponding 1446 intervention would produce on THAT input; if 1446 is inactive there, inject exactly zero",
      "matching_description": "a matched intervention rule on the current input. It is NOT perfect matching of entire sequence-generation trajectories: after arms diverge, paired arms need not have identical norms, and both the hypothetical control norms and the realised candidate-arm norms are recorded separately.",
      "top_k_policy": "the random direction is injected as a raw residual-space vector. SAE top-K support is never modified to implement it.",
      "control_caveat": "these are NOT the activation-matched SAE controls. Under the prespecified +/-20% rule feature 1446 had 0 of 5 eligible matched SAE controls. A random isotropic direction matches no activation statistic and lies outside the sparse code; it controls for perturbation magnitude at the edited token only."
    },
    "readout": {
      "name": "margin difference D",
      "margin": "margin(s) = single-site score(extr) - single-site score(cyto)",
      "D": "D = margin(variant) - margin(original)",
      "organism_model": "animal, fixed for every protein",
      "extraction": "PENDING VERIFICATION in score_variants.py: the summary line omits nonzero classes, so scores are recomputed from the --print-neighbors list through data/animal.wolfu and asserted to reproduce every printed score exactly",
      "naming": "predictor scores. Not probabilities and not biological measurements."
    },
    "compound_class_rule": "OPERATIONALLY DEFINED HERE, BEFORE GENERATION: compound (dual-site) classes are never added into the extr or cyto terms, because score('extr') already carries half-credit for every extr_* neighbour and adding a compound score would double count the same neighbours. Compound outputs are reported descriptively via the flags top_is_compound / top_mentions_extr / top_mentions_cyto. No compound-class sensitivity rule beyond this is defined, so none will be introduced after seeing results.",
    "analysis": {
      "unit": "protein. Replicates are averaged within protein before any across-protein summary. Steps, arms and replicates are not independent sample units.",
      "contrasts": [
        "each arm's paired original-to-variant D",
        "B-A",
        "C-A",
        "B-D",
        "C-E"
      ],
      "status": "exploratory P3 pilot evidence. No efficacy pass threshold, no confirmatory claim, no decision taken on whether any interval contains zero."
    },
