  "config": {
    "purpose": "bounded exploratory P3 sequence-variant pilot, run once at the frozen sample and replicate counts",
    "partition": "P3 (tuning) only. P4 is not read. P0 remains reserved and is never read.",
    "candidate": 1446,
    "candidate_provenance": "feature 1446 was selected during discovery on P1+P2 as a representative signal-associated feature (rank 3, AUROC 0.974, higher in Extracellular), before any P4 output existed. No new candidate selection is performed here, and the P4 result for 2564 is not used to choose a candidate.",
    "n_per_class": 20,
    "kingdom": "Metazoa",
    "selection_rule": "within each localisation class, sort eligible P3 Metazoa proteins by frozen sequence SHA-256 hex ascending and take the first 20. No random seed. No filtering on feature activation, annotation, WoLF PSORT scores or reference overlap.",
    "eligibility": "role == tuning and in_core == 1 in the prepared inclusion manifest (engineering proteins and p0_base_collision records already excluded); kingdom_deeploc == Metazoa; original length 60-1022; standard 20 amino acids only",
    "kingdom_rationale": "one WoLF PSORT organism model (animal) must apply to every protein: k, the reference set and the class vocabulary all differ between models, so scores are not comparable across them and per-protein model switching is not an option",
    "positions": [
      3,
      6,
